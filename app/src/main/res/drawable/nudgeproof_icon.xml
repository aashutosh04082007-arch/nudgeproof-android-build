<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:startColor="#120727" android:endColor="#3B0764" android:angle="315" />
        </shape>
    </item>
    <item android:left="18dp" android:right="18dp" android:top="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#A78BFA" />
            <solid android:color="#24103F" />
        </shape>
    </item>
</layer-list>
